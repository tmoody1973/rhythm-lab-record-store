SUBSONIC_URL=https://bandcamp.com/api/subsonic
SUBSONIC_USER=
SUBSONIC_PASSWORD=
SUBSONIC_API_KEY=

# Enrichment (copy from your Earmark project; never commit)
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Absolute path to the MusicKit .p8 key file (kept outside this repo)
APPLE_PRIVATE_KEY_PATH=
# Discogs consumer key/secret (Settings > Developers)
DISCOGS_KEY=
DISCOGS_SECRET=
# Contact MusicBrainz requires in the User-Agent
MUSICBRAINZ_CONTACT=
